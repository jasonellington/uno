+/// Custom emoji tapback (2006/3006) via Messages' own factory:
+/// `-[IMEmojiTapback initWithEmoji:isRemoved:]` then
+/// `-[IMTapback messageForChat:messageGUID:messagePartRange:messageSummaryInfo:threadIdentifier:]`.
+/// The factory writes the emoji, type and "Reacted ✅ to …" body itself, so
+/// nothing here depends on the private emoji setter. Both selectors exist on
+/// macOS 27; older systems get a clean error.
+static NSDictionary *sendCustomEmojiReaction(NSInteger requestId, IMChat *chat,
+                                             NSString *chatGuid, NSString *selectedMessageGuid,
+                                             NSString *reactionType, NSString *emoji,
+                                             BOOL removed, NSString *associatedRef,
+                                             NSRange targetRange, NSDictionary *summary) {
+    Class tapbackClass = NSClassFromString(@"IMEmojiTapback");
+    SEL initSel = NSSelectorFromString(@"initWithEmoji:isRemoved:");
+    SEL messageSel = NSSelectorFromString(
+        @"messageForChat:messageGUID:messagePartRange:messageSummaryInfo:threadIdentifier:");
+    if (!tapbackClass || ![tapbackClass instancesRespondToSelector:initSel]
+        || ![tapbackClass instancesRespondToSelector:messageSel]) {
+        return errorResponse(requestId,
+            @"Custom emoji tapbacks are not supported on this macOS (IMEmojiTapback missing)");
+    }
+    debugLog(@"handleSendReaction: custom target=%@ emoji=%@ removed=%d range={%lu,%lu}",
+             associatedRef, emoji, removed,
+             (unsigned long)targetRange.location, (unsigned long)targetRange.length);
+    @try {
+        id tapback = ((id (*)(id, SEL, id, BOOL))objc_msgSend)(
+            [tapbackClass alloc], initSel, emoji, removed);
+        id imMessage = tapback
+            ? ((id (*)(id, SEL, id, id, NSRange, id, id))objc_msgSend)(
+                  tapback, messageSel, chat, associatedRef, targetRange, summary, nil)
+            : nil;
+        if (!imMessage) {
+            return errorResponse(requestId, @"Could not build custom tapback IMMessage");
+        }
+        [chat performSelector:@selector(sendMessage:) withObject:imMessage];
+        debugLog(@"handleSendReaction: custom dispatched");
+        NSString *guid = outgoingMessageGuid(imMessage);
+        return successResponse(requestId, @{
+            @"chatGuid": chatGuid,
+            @"selectedMessageGuid": selectedMessageGuid,
+            @"reactionType": reactionType,
+            @"emoji": emoji,
+            @"messageGuid": guid ?: @""
+        });
+    } @catch (NSException *exception) {
+        return errorResponse(requestId,
+            [NSString stringWithFormat:@"send-reaction failed: %@", exception.reason]);
+    }
+}
