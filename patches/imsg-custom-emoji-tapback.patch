+/// Bridge params for a tapback: the six classic kinds (and their emoji
+/// aliases) keep their kind; any other single emoji becomes `custom` /
+/// `remove-custom` with the emoji alongside.
+func bridgeReactionParams(_ raw: String, remove: Bool = false) throws -> [String: Any] {
+  do {
+    return ["reactionType": try normalizeBridgeReactionType(raw, remove: remove)]
+  } catch {
+    var value = raw.trimmingCharacters(in: .whitespacesAndNewlines)
+    var shouldRemove = remove
+    if value.lowercased().hasPrefix("remove-") {
+      shouldRemove = true
+      value.removeFirst("remove-".count)
+    }
+    guard isSingleEmoji(value) else { throw error }
+    return [
+      "reactionType": shouldRemove
+        ? BridgeReactionKind.removeCustom.rawValue : BridgeReactionKind.custom.rawValue,
+      "emoji": value,
+    ]
+  }
+}
+
+/// One grapheme that renders as emoji: emoji presentation by default, or a
+/// text-default emoji forced with VS16 / built from several scalars (ZWJ,
+/// skin tone, flags). Plain digits and symbols like "#" don't count.
+func isSingleEmoji(_ value: String) -> Bool {
+  guard value.count == 1, let character = value.first else { return false }
+  let scalars = character.unicodeScalars
+  if scalars.contains(where: { $0.properties.isEmojiPresentation }) { return true }
+  guard scalars.first?.properties.isEmoji == true else { return false }
+  return scalars.count > 1
+}
