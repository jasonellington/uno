+@Test
+func rpcTapbackParamsKeepClassicKindsAndCarryCustomEmoji() throws {
+  // Classic kinds and their emoji aliases stay classic, with no emoji param.
+  for (raw, kind) in [
+    ("👍", "like"), ("👎", "dislike"), ("❤️", "love"), ("😂", "laugh"), ("‼️", "emphasize"),
+    ("❓", "question"), ("love", "love"),
+  ] {
+    let params = try bridgeReactionParams(raw)
+    #expect(params["reactionType"] as? String == kind)
+    #expect(params["emoji"] == nil)
+  }
+  for emoji in ["🎉", "🔥", "💯", "👀", "🙏", "✅", "👍🏽", "❤️‍🔥", "🇺🇸"] {
+    let params = try bridgeReactionParams(emoji)
+    #expect(params["reactionType"] as? String == "custom")
+    #expect(params["emoji"] as? String == emoji)
+  }
+  let removal = try bridgeReactionParams("✅", remove: true)
+  #expect(removal["reactionType"] as? String == "remove-custom")
+  #expect(removal["emoji"] as? String == "✅")
+  #expect(try bridgeReactionParams("remove-✅")["reactionType"] as? String == "remove-custom")
+  #expect(try bridgeReactionParams("👍", remove: true)["reactionType"] as? String == "remove-like")
+}
+
+@Test
+func rpcTapbackParamsRejectNonEmoji() {
+  for raw in ["", "wave", "✅✅", "1", "#", "ok 👍"] {
+    #expect(throws: RPCError.self) { try bridgeReactionParams(raw) }
+  }
+}
