      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.6"
    },
    "install": {
      "minHostVersion": ">=2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.7"
    }
  }
}
