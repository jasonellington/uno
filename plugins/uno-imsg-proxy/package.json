{
  "name": "uno-imsg-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Uno's iMessage style: quick reactions, tapbacks, typing, bubbles, link previews and plain error lines.",
  "license": "MIT",
  "type": "module",
  "os": [
    "darwin"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
